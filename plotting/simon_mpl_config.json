{
    "axis_labels": {
        "pt": "$p_{T}$ [GeV]",
        "eta": "$\\eta$",
        "phi": "$\\phi$",
        "energy": "$E$ [GeV]",
        "mass": "$m$ [GeV]",
        "*simEnergy" : "$E_{sim}$ [GeV]",
        "*track_energy" : "$E_{gen}$ [GeV]",
        "*pdgId" : "pdgId",
        "*.simEnergy_minus_*.impact_energy_over_*.impact_energy" : "$(E_{sim} - E_{gen}) / E_{sim}$",
        "*.energy_minus_*.simenergy_over_*.simenergy" : "$(E_{reco} - E_{sim}) / E_{sim}$"
    },
    "figsize": [12, 10],
    "cms_label" : "Work in Progress"
}